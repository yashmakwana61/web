# Sanity (read-only from the browser — the site never writes to Sanity)
NEXT_PUBLIC_SANITY_PROJECT_ID=e0ws8top
NEXT_PUBLIC_SANITY_DATASET=production

# Supabase (anon key is safe to expose — it only grants permission to invoke
# Edge Functions; RLS denies it any direct table access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Everything below is server-side only. Never prefix with NEXT_PUBLIC_,
# never commit real values, and never reference these from a 'use client' file. ---

# Used by the existing /api/contact route today. Superseded by the `lead`
# Supabase Edge Function; kept here only until that route is retired.
SANITY_API_WRITE_TOKEN=
RESEND_API_KEY=
RESEND_TO_EMAIL=

# Set as Supabase Edge Function secrets (via the Supabase dashboard/CLI), not here:
#   SUPABASE_SERVICE_ROLE_KEY
#   SANITY_READ_TOKEN (only needed if the dataset is private)
